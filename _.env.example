# Copy to .env and change the values. Compose reads .env automatically.
# DB_USER / DB_PASSWORD must match the VProfile app (admin / admin123)
# unless you rebuild the app with different settings.
DB_ROOT_PASSWORD=admin123
DB_USER=admin
DB_PASSWORD=admin123

RABBITMQ_USER=test
RABBITMQ_PASSWORD=test

NAGIOS_USER=nagiosadmin
NAGIOS_PASSWORD=nagios

ZABBIX_DB_ROOT_PASSWORD=rootpass
ZABBIX_DB_PASSWORD=zabbixpass
